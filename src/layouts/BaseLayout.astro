---
import '../styles/global.css';
export interface Props {
  title?: string;
  font?: 'pt' | 'ia';
}
const { title = "Pravin Goomannee — Blog", font = 'pt' } = Astro.props;
const year = new Date().getFullYear();
if (font === 'ia') {
  await import('@fontsource/ia-writer-quattro/400.css');
  await import('@fontsource/ia-writer-quattro/700.css');
}
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <slot name="head" />
  </head>
  <body class={font === 'ia' ? 'font-ia' : ''}>
    <header class="site-header">
      <a href="/" class="site-logo">Pravin Goomannee</a>
      {Astro.slots.has('breadcrumbs') && (
        <div class="site-breadcrumbs">
          <slot name="breadcrumbs" />
        </div>
      )}
    </header>
    <main class="site-main">
      <slot />
    </main>
    <footer class="site-footer">
      <p>© {year} Pravin Goomannee. All rights reserved.</p>
      {font === 'ia' && (
        <p>Typeface: iA Writer Quattro — © iA. Used under its license.</p>
      )}
    </footer>
  </body>
</html>
