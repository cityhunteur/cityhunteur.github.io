---
import type { CollectionEntry } from 'astro:content';
export interface Props {
  post: CollectionEntry<'posts'>;
}
const { post } = Astro.props;
const { title, cover, coverAlt, date } = post.data;
const url = `/${post.slug}/`;
const isoDate = date.toISOString();
const displayDate = new Intl.DateTimeFormat('en-US', {
  month: 'long',
  day: 'numeric',
  year: 'numeric',
}).format(date);

const clean = (block: string) =>
  block
    .replace(/<[^>]*>/g, ' ')
    .replace(/!\[[^\]]*\]\([^)]*\)/g, '')
    .replace(/\[[^\]]*\]\([^)]*\)/g, '$1')
    .replace(/[`*_>#]/g, '')
    .replace(/\s+/g, ' ')
    .trim();

const blocks = post.body
  .split(/\r?\n\s*\n/)
  .map(clean)
  .filter(Boolean)
  .map((block) => block.trim());

const excerptBlocks = blocks
  .filter((block) => block.split(' ').length > 4)
  .slice(0, 2);

const previewParagraphs =
  excerptBlocks.length > 0
    ? excerptBlocks
    : blocks.length > 0
        ? [blocks[0]]
        : [];
---
<article class="post-preview">
  <header>
    <h2><a href={url}>{title}</a></h2>
    <time datetime={isoDate}>{displayDate}</time>
  </header>
  <p class="post-image">
    <a href={url}>
      <img src={cover} alt={coverAlt ?? title} loading="lazy" />
    </a>
  </p>
  {previewParagraphs.map((paragraph) => (
    <p>{paragraph}</p>
  ))}
  <div class="more">
    <a href={url} aria-label={`Read more: ${title}`}>Read more</a>
  </div>
</article>

<style>
.post-preview {
  padding: 2.8em 0;
  border-bottom: 1px solid var(--border-subtle);
}

.post-preview:last-child {
  border-bottom: none;
}

.post-preview header {
  display: flex;
  flex-direction: column;
  gap: 0.4em;
  margin-bottom: 1.6em;
}

.post-preview h2 {
  font-size: 1.7em;
  margin: 0;
}

.post-preview h2 a {
  color: inherit;
}

.post-image {
  margin: 0.5em 0 1.2em;
}

.post-image a {
  display: block;
}

.post-image img {
  width: 100%;
  height: auto;
}

.post-preview p {
  margin: 1.2em 0;
}

.post-preview .more {
  margin-top: 2em;
}

@media (min-width: 768px) {
  .post-preview h2 {
    font-size: 1.8em;
  }
}
</style>
