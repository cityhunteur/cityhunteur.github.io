---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostRow from '../components/PostRow.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const pageDescription =
  'Systems, craft, and notes from an engineering journey — essays on building software, leading teams, and curiosity projects.';
---
<BaseLayout title="Pravin Goomannee — Blog" description={pageDescription}>
  <header class="page-lede">
    <h1>Systems, craft, and notes from an engineering journey.</h1>
    <p>
      Essays on building software, leading teams, and the side projects that keep me curious.
    </p>
  </header>
  <div class="post-list">
    {posts.map((post, index) => (
      <PostRow post={post} featured={index === 0} />
    ))}
  </div>
</BaseLayout>

<style>
.page-lede {
  max-width: 50ch;
  margin-bottom: 3em;
}

.page-lede p {
  margin-top: 1em;
  text-align: left;
}
</style>

