import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page Not Found — Pravin Goomannee"
  description="Sorry, the page you were trying to reach can’t be found. Head back to the latest writing."
>
  <section class="not-found">
    <h1>Page not found</h1>
    <p>
      The page you’re looking for might have been moved, renamed, or no longer exists. Let’s head back to the latest posts.
    </p>
    <div class="more">
      <a href="/">Return home</a>
    </div>
  </section>
</BaseLayout>

<style>
.not-found {
  margin: 6em auto;
  text-align: center;
  max-width: 60ch;
}

.not-found p {
  margin: 1.5em auto 2em;
  text-align: center;
}

.not-found .more {
  justify-content: center;
  display: inline-flex;
}
</style>
